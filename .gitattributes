# 统一换行符，避免 Windows / macOS 组员之间产生整文件 diff
* text=auto

# 源码与文本文件统一用 LF 存储
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# 二进制文件不做换行符转换
*.pdf   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
